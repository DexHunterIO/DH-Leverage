FROM golang:1.24-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/dh-leverage .

FROM alpine:latest
RUN apk --no-cache add ca-certificates
WORKDIR /app
COPY --from=builder /out/dh-leverage /app/dh-leverage
COPY .env /app/.env
EXPOSE 8080
CMD ["/app/dh-leverage", "api"]
