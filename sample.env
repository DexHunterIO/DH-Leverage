API_PORT=
DATABASE_URL=
REDIS_URL=
UNIX_SOCKET=
TCP_SOCKET=
CONNECTION_TYPE=

# Leverage engine (server-driven long/short looping).
# BlockFrost is used to build the funding/sweep txs and read temp-address
# chain state. DexHunter partner key signs the swap legs. ENGINE_ENC_KEY
# (32-byte hex or any passphrase) encrypts the temp signing keys at rest.
BLOCKFROST_PROJECT_ID=
BLOCKFROST_BASE_URL=https://cardano-mainnet.blockfrost.io/api
DEXHUNTER_PARTNER_ID=
ENGINE_ENC_KEY=
CARDANO_NETWORK=mainnet

# Strike Finance v2 perpetuals (builder-codes model). Register at
# https://app.strikefinance.org/builder-codes for your builder code + fee share.
# STRIKE_FEE_BPS must be <= your registered share (and <= 100). Without a builder
# code, Strike is read-only (positions/account by address).
STRIKE_BASE_URL=https://api.strikefinance.org
STRIKE_BUILDER_CODE=dh-test
STRIKE_FEE_BPS=100

# Per-source protocol logging (Liqwid/Surf request/response bodies + lend/borrow
# math). OFF by default so it doesn't bury the leverage-engine logs. Set to 1 to
# re-enable when debugging a source.
LOG_SOURCES=
